<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles every runtime script in Assets/Scripts against the Unity 2021.3
       reference assemblies (NuGet), to catch compile errors without the Unity Editor.
       TextMeshPro is not on NuGet; ThirdPartyStubs.cs declares the members the game uses.
       Usage: dotnet build (from this folder)
              dotnet build -p:WithSdks=true   (also compiles the AdMob/Firebase/IAP code paths
                                               against SdkStubs.cs) -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0414;CS0169;CS0649;NU1701</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <DefineConstants Condition="'$(WithSdks)' == 'true'">$(DefineConstants);WATERSORT_ADMOB;WATERSORT_FIREBASE;WATERSORT_IAP</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Scripts/**/*.cs" />
    <Compile Include="ThirdPartyStubs.cs" />
    <Compile Include="SdkStubs.cs" Condition="'$(WithSdks)' == 'true'" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" />
    <PackageReference Include="Unity3D.UnityEngine.UI" Version="2018.3.5.1" />
  </ItemGroup>
</Project>
